{
  "name": "@clankv7/rng",
  "version": "0.1.0-experimental.1",
  "private": true,
  "description": "Experimental TriFlow v1 PRNG: milestone 2 raw TypeScript engine",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
